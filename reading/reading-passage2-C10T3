    <script>
        // ✅ Correct answer data
        const correctAnswers = {
            q14: 'C',
            q15: 'B',
            q16: 'H',
            q17: 'B',
            q18: 'E',
            q19: 'sun',
            q20: 'upper',
            q21: 'dry',
            q22: 'north',
            q23: 'FALSE',
            q24: 'TRUE',
            q25: 'NOT GIVEN',
            q26: 'B'
        };

        // ✅ Save answers to localStorage
        function saveAnswers() {
            let answers = {};
            for (let q = 14; q <= 26; q++) {
                const radios = document.getElementsByName(`q${q}`);
                if (radios.length > 0) {
                    for (let r of radios) {
                        if (r.checked) answers[`q${q}`] = r.value;
                    }
                } else {
                    const input = document.querySelector(`input[name="q${q}"]`);
                    if (input) answers[`q${q}`] = input.value.trim().toLowerCase();
                }
            }
            localStorage.setItem('C10T3P2_answers', JSON.stringify(answers));
        }

        // ✅ Load saved answers
        function loadAnswers() {
            const saved = localStorage.getItem('C10T3P2_answers');
            if (!saved) return;
            const answers = JSON.parse(saved);
            for (let key in answers) {
                const radios = document.getElementsByName(key);
                if (radios.length > 0) {
                    for (let r of radios) {
                        if (r.value.toUpperCase() === answers[key].toUpperCase()) r.checked = true;
                    }
                } else {
                    const input = document.querySelector(`input[name="${key}"]`);
                    if (input) input.value = answers[key];
                }
            }
        }

        // ✅ Highlight text function
        document.getElementById('passageArea').addEventListener('mouseup', function() {
            const selection = window.getSelection();
            if (selection.toString().trim().length > 0) {
                const span = document.createElement('span');
                span.className = 'highlight';
                span.textContent = selection.toString();
                const range = selection.getRangeAt(0);
                range.deleteContents();
                range.insertNode(span);
                selection.removeAllRanges();
            }
        });

        function clearHighlights() {
            document.querySelectorAll('.highlight').forEach(el => {
                el.outerHTML = el.innerHTML;
            });
        }

        // ✅ Fixed toggle function
        function toggleAnswers() {
            const box = document.getElementById('answersBox');
            box.style.display = box.style.display === 'block' ? 'none' : 'block';
        }

        function showStudentAnswers() {
            saveAnswers();
            const box = document.getElementById('studentAnswersBox');
            const resultDiv = document.getElementById('studentResult');
            let html = '';
            let score = 0;

            for (let q = 14; q <= 26; q++) {
                let studentAns = '';
                const radios = document.getElementsByName(`q${q}`);
                if (radios.length > 0) {
                    for (let r of radios) {
                        if (r.checked) studentAns = r.value;
                    }
                } else {
                    const input = document.querySelector(`input[name="q${q}"]`);
                    if (input) studentAns = input.value.trim().toLowerCase();
                }

                const correct = correctAnswers[`q${q}`].toLowerCase();
                let status = '';
                if (!studentAns) {
                    status = '<span class="no-answer">(No Answer)</span>';
                } else if (studentAns === correct) {
                    status = '<span class="correct">✅ Correct</span>';
                    score++;
                } else {
                    status = `<span class="wrong">❌ Wrong (Correct: ${correctAnswers[`q${q}`]})</span>`;
                }

                html += `<strong>${q}.</strong> Your answer: ${studentAns || '-'} &nbsp; ${status}<br>`;
            }

            html += `<br><strong>Total Score: ${score} / 13</strong>`;
            resultDiv.innerHTML = html;
            box.style.display = box.style.display === 'block' ? 'none' : 'block';
        }

        // Load saved answers when page opens
        window.onload = loadAnswers;
    </script>

